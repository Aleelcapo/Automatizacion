       "target": "cu",
       "pop": true,
       "sfx": "pop"
      }
     ]
    }
   ]
  },
  {
   "text": "Y sonreía. No era un truco: de verdad no sentía nada.",
   "shots": [
    {
     "scene": "ninoC",
     "cam": {
