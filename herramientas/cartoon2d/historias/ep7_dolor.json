 "beats": [
  {
   "text": "Me contaron el caso de un niño que trabajaba en la calle haciendo shows.",
   "shots": [
    {
     "scene": "calle",
     "cam": {
      "x": 540,
      "y": 1000,
      "z": 1.0,
      "move": "push"
     }
