    {
     "scene": "calle",
     "cam": {
      "x": 540,
      "y": 1600,
      "z": 1.7,
      "move": "push"
     }
    }
   ]
  },
  {
   "text": "Se atravesaba el brazo con cuchillos.",
   "shots": [
    {
     "scene": "calle",
     "cam": {
      "x": 700,
      "y": 1150,
      "z": 1.5,
      "move": "push"
