     "do": [
      {
       "on": "pierna",
       "target": "h",
       "sway": 0.6,
       "dur": 0.3
      }
     ]
    }
   ]
  },
  {
   "text": "Trabajaba, estaba casado, tenía dos hijos. Una vida completamente normal.",
   "shots": [
    {
     "scene": "familia",
     "cam": {
      "on": [
       "h",
       "f"
      ],
      "shot": "medium",
      "move": "drift"
