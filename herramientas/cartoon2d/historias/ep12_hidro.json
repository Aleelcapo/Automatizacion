       "at": 0.2,
       "target": "f",
       "look": [
        -0.8,
        0
       ]
      }
     ]
    }
   ]
  },
  {
   "text": "Leo pidió una resonancia de rutina.",
   "shots": [
    {
     "scene": "mri",
     "cam": {
      "x": 540,
      "y": 900,
      "z": 1.0,
      "move": "push"
     }
    }
   ]
  },
  {
   "text": "Cuando la vio, pensó que la máquina estaba rota.",
   "shots": [
    {
     "scene": "aula",
     "cam": {
      "on": "leo",
      "shot": "close",
      "move": "push"
     },
     "do": [
      {
       "at": 0,
       "target": "leo",
       "expr": "shock"
      }
     ]
    }
   ]
  },
  {
   "text": "Ana pensó que habían cargado la imagen de otra persona.",
   "shots": [
    {
     "scene": "anaC",
     "cam": {
      "on": "ana",
      "shot": "close",
      "move": "push"
     },
     "do": [
      {
       "at": 0,
       "target": "ana",
       "expr": "confused",
       "talk": 2.0
      }
     ]
    }
   ]
  },
  {
   "text": "Pero no. La cabeza del hombre estaba casi vacía. Llena de líquido. Y su cerebro... era una capa finita, aplastada contra el cráneo.",
   "shots": [
    {
     "scene": "scan",
     "flash": true,
     "cam": {
      "x": 540,
      "y": 800,
      "z": 1.0,
      "move": "push"
     },
     "do": [
      {
       "on": "vacía",
       "target": "sc",
       "value": 1,
       "dur": 1.2,
       "sfx": "ding"
      }
     ]
    },
    {
     "scene": "scan",
     "from": "capa",
     "cam": {
      "x": 700,
      "y": 700,
      "z": 1.6,
      "move": "push"
     },
     "do": [
      {
       "at": 0,
       "target": "sc",
       "value": 1,
       "dur": 0.01
      }
     ]
    }
   ]
  },
  {
   "text": "De bebé había tenido hidrocefalia: el líquido que protege al cerebro no se drenaba bien y se iba acumulando.",
   "shots": [
    {
     "scene": "bebe",
     "cam": {
      "x": 540,
      "y": 800,
      "z": 1.0,
      "move": "push"
     }
    },
    {
     "scene": "liquido",
     "from": "líquido",
     "cam": {
      "x": 540,
      "y": 820,
      "z": 1.0,
      "move": "push"
     },
     "do": [
      {
       "on": "acumulando",
       "target": "f",
       "value": 0.5,
       "dur": 1.4
      }
     ]
    }
   ]
  },
  {
   "text": "Le habían puesto un tubo para sacarlo. Pero con los años, el líquido siguió empujando, despacio, durante décadas.",
   "shots": [
    {
     "scene": "liquido",
     "cam": {
      "x": 540,
      "y": 820,
      "z": 1.0,
      "move": "push"
     },
     "do": [
      {
       "at": 0,
       "target": "f",
       "value": 0.5,
       "dur": 0.01
      },
      {
       "on": "siguió",
       "target": "f",
       "value": 1,
       "dur": 3.0
      }
     ]
    }
   ]
  },
  {
   "text": "Y acá está lo increíble. Como pasó tan lento, su cerebro se fue adaptando.",
