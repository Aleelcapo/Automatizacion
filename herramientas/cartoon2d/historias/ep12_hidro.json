 "beats": [
  {
   "text": "Un hombre de 44 años vino por algo simple: le fallaba un poco la pierna.",
   "shots": [
    {
     "scene": "hombre",
     "cam": {
      "on": "h",
      "shot": "medium",
      "move": "push"
     }
    },
    {
