      }
     ]
    }
   ]
  },
  {
   "text": "Las funciones se reacomodaron en el espacio que quedaba. Las neuronas que sobrevivieron aprendieron a hacer el trabajo de las que faltaban.",
   "shots": [
    {
     "scene": "adapta",
